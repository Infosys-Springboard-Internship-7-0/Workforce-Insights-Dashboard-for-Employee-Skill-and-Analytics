# ==============================================================================
# AI Workforce Assistant Platform — backend environment template
# Copy to `.env` and fill in real values. Never commit `.env`.
# ==============================================================================

# ---- App ----
APP_NAME=AI Workforce Assistant Platform
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# ---- LLM (Groq) ----
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=openai/gpt-oss-20b

# ---- Embeddings (local, no API key needed) ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- ChromaDB (persisted locally) ----
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=workforce_documents

# ---- RAG tuning ----
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K_CHUNKS=5

# ---- Storage ----
DOCUMENTS_DIR=./data/documents
DATASETS_DIR=./data/datasets

# ---- Database (admins, team members, powerbi links, document metadata) ----
DATABASE_URL=sqlite:///./data/platform.db

# ---- Security ----
JWT_SECRET_KEY=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# ---- First-run admin seed (used only if no admin exists yet) ----
INITIAL_ADMIN_EMAIL=info@gu-saurabh.site
INITIAL_ADMIN_PASSWORD=change_this_password
INITIAL_ADMIN_NAME=Platform Admin
